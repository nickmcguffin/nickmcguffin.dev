{
  "useTabs": true,
  "singleQuote": true,
  "printWidth": 100,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": ["*.css", "*.json", "*.md", "*.yml", ".prettierrc"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ]
}
