---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, getReadingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, published } = post.data;

const minutes = getReadingMinutes(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const label = 'font-mono text-[11px] uppercase tracking-[0.12em]';
---

<Base title={title} description={description} published={published}>
	<div class="flex gap-14">
		{
			toc.length > 0 && (
				<aside class="hidden w-52 shrink-0 lg:block">
					<nav class="sticky top-10 self-start" aria-labelledby="toc-label">
						<p id="toc-label" class:list={[label, 'text-muted']}>
							Contents
						</p>
						<div class="mt-4">
							<TableOfContents headings={toc} />
						</div>
					</nav>
				</aside>
			)
		}

		<article class="min-w-0 max-w-[62ch]">
			<a href="/blog" class:list={[label, 'text-muted hover:text-fg']}>&larr; All writing</a>

			<h1
				class="mt-7 font-display text-3xl font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-4xl"
			>
				{title}
			</h1>

			<div class:list={[label, 'mt-5 flex flex-wrap gap-x-5 gap-y-1 text-muted']}>
				<time datetime={published.toISOString()}>
					{published.toLocaleDateString('en-AU', { timeZone: 'UTC', dateStyle: 'long' })}
				</time>
				{minutes && <span>{minutes} min read</span>}
			</div>

			{
				toc.length > 0 && (
					<details id="toc-mobile" class="group mt-8 border-y border-rule lg:hidden">
						<summary
							class:list={[
								label,
								'flex cursor-pointer list-none items-center justify-between py-4 text-muted [&::-webkit-details-marker]:hidden',
							]}
						>
							Contents
							<svg
								viewBox="0 0 12 12"
								width="12"
								height="12"
								aria-hidden="true"
								class="transition-transform group-open:rotate-180"
							>
								<path
									d="M2 4.5 L6 8.5 L10 4.5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
								/>
							</svg>
						</summary>
						<div class="pb-4">
							<TableOfContents headings={toc} />
						</div>
					</details>
				)
			}

			<div class="post mt-10 border-t border-rule pt-10 lg:mt-10">
				<Content />
			</div>
		</article>
	</div>
    <script>
        // Collapse the mobile contents once a link is followed
        const toc = document.getElementById('toc-mobile') as HTMLDetailsElement | null;
        toc?.addEventListener('click', (event) => {
            if ((event.target as HTMLElement).closest('a')) toc.open = false;
        });
    </script>
</Base>