---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

const deck = 'Notes on what I build, and the parts that break.';
---

<Base title="Blog" description={deck}>
	<div class="border-b border-rule pb-6">
		<h1 class="font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">Blog</h1>
		<p class="mt-3 max-w-prose leading-relaxed text-muted">{deck}</p>
	</div>

	<ul class="divide-y divide-rule">
		{
			posts.map((post) => (
				<li>
					<PostRow post={post} />
				</li>
			))
		}
	</ul>
</Base>