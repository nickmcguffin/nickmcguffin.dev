---
import Base from '../layouts/Base.astro';
import RouteGraphic from '../components/RouteGraphic.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts } from '../lib/posts';

// Latest 3 blog posts.
const posts = (await getPosts()).slice(0, 3);
 
---
 
<Base>
	<section class="flex flex-col-reverse items-start gap-10 sm:flex-row sm:items-end sm:justify-between">
		<div class="max-w-xl">
			<p class:list={['label', 'text-muted']}>Full-stack engineer &nbsp;·&nbsp; North Queensland, Australia</p>
 
			<h1
				class="mt-5 font-display text-4xl font-extrabold leading-[0.97] tracking-[-0.035em] sm:text-5xl lg:text-6xl"
			>
				Systems that have to keep working.
			</h1>
 
			<p class="mt-4 max-w-prose leading-relaxed text-muted">
				I'm a full-stack engineer with four years on defence communications systems. 
				Now building my own things and writing about how they work, the decisions behind them, and the parts that break.
			</p>
		</div>
 
		<RouteGraphic class="w-32 shrink-0 sm:w-44 lg:w-52" />
	</section>
 
	<section class="mt-12">
		<div class="flex items-baseline justify-between border-b border-rule pb-3">
			<div class="flex items-baseline gap-3">
				<span class:list={['label', 'text-accent']}>01</span>
				<span class:list={['label', 'text-muted']}>Recent writing</span>
			</div>
 
			<a href="/blog" class:list={['label', 'text-muted hover:text-fg']}>All writing &rarr;</a>
		</div>
 
		<ul class="divide-y divide-rule">
			{
				posts.map((post) => (
					<li>
						<PostRow post={post} />
					</li>
				))
			}
		</ul>
	</section>
</Base>
 