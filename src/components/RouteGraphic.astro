---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<svg
	viewBox="0 0 150 150"
	class:list={['text-accent', className]}
	aria-hidden="true"
	xmlns="http://www.w3.org/2000/svg"
>
	<g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" >
		<path class="route" style="--i: 0" pathLength="1" d="M14 116 L52 74 L96 92 L136 34" />
		<path class="route" style="--i: 1" pathLength="1" stroke-opacity="0.45" d="M14 116 L60 122 L96 92" />
		<path class="route" style="--i: 2" pathLength="1" stroke-opacity="0.45" d="M52 74 L74 30 L136 34" />
		<path class="route" style="--i: 3" pathLength="1" stroke-opacity="0.25" d="M60 122 L118 108 L136 34" />
	</g>

	<g fill="currentColor">
		<circle class="node" style="--i: 0" cx="14" cy="116" r="3.4" />
		<circle class="node" style="--i: 1" cx="52" cy="74" r="2.6" />
		<circle class="node" style="--i: 2" cx="60" cy="122" r="2" />
		<circle class="node" style="--i: 3" cx="74" cy="30" r="2" />
		<circle class="node" style="--i: 3" cx="96" cy="92" r="2.6" />
		<circle class="node" style="--i: 4" cx="118" cy="108" r="2" />
	</g>

	<g class="node" style="--i: 5">
		<circle cx="136" cy="34" r="6" fill="none" stroke="currentColor" stroke-width="1.4" />
		<circle cx="136" cy="34" r="2.6" fill="currentColor" />
	</g>
</svg>

<style>
	/* Resting state is the finished graphic. Motion is layered on below,
	   so reduced-motion users get the completed drawing immediately. */
	.node {
		transform-box: fill-box;
		transform-origin: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		.route {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
			animation: draw 520ms ease-out forwards;
			animation-delay: calc(var(--i) * 150ms);
		}

		.node {
			opacity: 0;
			animation: land 260ms ease-out forwards;
			animation-delay: calc(var(--i) * 150ms + 260ms);
		}

		@keyframes draw {
			to {
				stroke-dashoffset: 0;
			}
		}

		@keyframes land {
			from {
				opacity: 0;
				transform: scale(0.4);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}
	}
</style>