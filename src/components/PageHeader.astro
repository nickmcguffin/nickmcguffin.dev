---
interface Props {
	title: string;
	deck?: string;
}

const { title, deck } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-5 border-b border-rule pb-6">
	<div>
		<h1 class="font-display text-4xl font-extrabold tracking-[-0.035em] sm:text-5xl">
			{title}
		</h1>
		{deck && <p class="mt-3 max-w-prose leading-relaxed text-muted">{deck}</p>}
	</div>

	<slot name="action" />
</div>
